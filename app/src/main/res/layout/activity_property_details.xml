<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/descripcion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Descripción: "/>


    <TextView
        android:id="@+id/capacidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Capacidad: "/>

    <TextView
        android:id="@+id/ubicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ubicación"/>
    <TextView
        android:id="@+id/amenidades"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amenidades: "/>
    <TextView
        android:id="@+id/precio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Precio"/>
    <TextView
        android:id="@+id/reglas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reglas"/>
    <TextView
        android:id="@+id/fechainicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inicio de disponibilidad"/>

    <TextView
        android:id="@+id/fechafin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fin de disponibilidad"/>
    <TextView
        android:id="@+id/reglas1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reglas"/>
    <Button
        android:id="@+id/selectStartDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar fecha de inicio" />

    <Button
        android:id="@+id/selectEndDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar fecha de fin" />
    <Button
        android:id="@+id/buttonRent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alquilar"
        android:layout_marginTop="16dp"/>
</LinearLayout>
